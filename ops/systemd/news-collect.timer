# Once per weekday at 23:00 Pacific (America/Vancouver). Moved 2026-11-04
# from 22:00 at the operator's request (DECISIONS V5). The earlier move,
# 2026-10-02, went from 22:30 UTC to 22:00 Pacific. 23:00 Pacific is ten or
# more hours after the regular close, far past the SIP settle and the daily
# bar cut.
#
# The target session is unchanged. The wrapper picks the latest session
# whose following session closed at least SETTLE_MINUTES ago, so a Monday
# 23:00 firing still collects Friday. Finnhub's company-news query is a
# whole-date window, so the later fetch sees the same day. A firing on a
# holiday resolves to a clean no-op.
[Unit]
Description=MAL daily news collection schedule

[Timer]
OnCalendar=Mon..Fri *-*-* 23:00:00 America/Vancouver
# A machine asleep or off at 23:00 runs the job at next wake instead of
# skipping it. The wrapper's idempotence makes late firings safe.
# (A run that STARTS and is then killed is not retried: session 2026-10-30
# was lost that way on 2026-11-02.)
Persistent=true
RandomizedDelaySec=120

[Install]
WantedBy=timers.target
